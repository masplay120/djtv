    const FORBIDDEN_WORDS = [
      "horoscopo", "horóscopo", "zodiaco", "zodíaco", "signo", "signos",
      "quiniela", "quinielas", "lotería", "loteria", "kini 6", "quini 6",
      "loto", "telekino", "enterate", "entérate", "conocé los resultados",
      "conoce los resultados", "mira el resultado", "mirá el resultado",
      "qué dice el tarot", "que dice el tarot", "sudoku", "crucigrama"
    ];

    function isUsefulNews(text) {
      if (!text || text.trim().length < 15) return false;
      const cleanLowerText = text.toLowerCase();
      for (const word of FORBIDDEN_WORDS) {
        if (cleanLowerText.includes(word)) return false;
      }
      return true;
    }

    let allNews = [];
    let rssAnimationId = null;

    function cleanText(html) {
      const tmp = document.createElement("DIV");
      tmp.innerHTML = html;
      return tmp.textContent || tmp.innerText || "";
    }

    async function fetchAllNews() {
      let collectedNews = [];

      for (const feed of rssFeeds) {
        try {
          const apiUrl = `https://api.rss2json.com/v1/api.json?rss_url=${encodeURIComponent(feed.url)}`;
          const response = await fetch(apiUrl);
          const data = await response.json();

          if (data.status === 'ok' && data.items && data.items.length > 0) {
            const items = [];
            for (const item of data.items) {
              const title = cleanText(item.title).trim();
              const summary = cleanText(item.description || item.content || "").trim();

              let fullNews = title;
              if (summary.length > 15 && !summary.includes(title)) {
                fullNews += ` — ${summary}`;
              }

              if (isUsefulNews(fullNews)) {
                items.push({ text: fullNews, source: feed.name });
              }
              if (items.length >= 8) break;
            }
            collectedNews = collectedNews.concat(items);
          }
        } catch (e) {
          console.error(`Error RSS ${feed.name}:`, e);
        }
      }

      if (collectedNews.length > 0) {
        allNews = collectedNews.sort(() => Math.random() - 0.5);
        renderAndStartTicker();
      }
    }

    function renderAndStartTicker() {
      const container = document.getElementById('ticker-text');
      if (rssAnimationId) cancelAnimationFrame(rssAnimationId);

      let htmlContent = '';
      allNews.forEach(item => {
        htmlContent += `
          <div class="news-item">
            <span class="news-source">${item.source}</span> ${item.text}
            <span class="news-separator">•</span>
          </div>
        `;
      });

      container.innerHTML = htmlContent + htmlContent;

      let posX = 0;
      const speed = 1.4;

      function step() {
        posX -= speed;
        const halfWidth = container.scrollWidth / 2;

        if (Math.abs(posX) >= halfWidth) {
          posX = 0;
        }

        container.style.transform = `translateX(${posX}px)`;
        rssAnimationId = requestAnimationFrame(step);
      }

      step();
    }

    fetchAllNews();
    setInterval(fetchAllNews, 600000);
  </script>
</body>
