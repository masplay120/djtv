<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DJ TV Estación Mix - Master Broadcast Zócalo</title>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;700;800;900&family=Orbitron:wght@700;900&family=Oswald:wght@600;700;800&display=swap" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html, body {
      margin: 0 !important;
      padding: 0 !important;
      background: transparent !important;
      background-color: rgba(0, 0, 0, 0) !important;
      overflow: hidden;
      font-family: 'Montserrat', sans-serif;
      width: 1920px;
      height: 1080px;
      user-select: none;
    }

    /* CONTENEDOR MAESTRO LIENZO 1920X1080 */
    .tv-master-lower-third {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 1920px;
      height: 1080px;
      z-index: 9999;
      pointer-events: none;
    }

    /* ---------------------------------------------------
       1. PISO SUPERIOR: PLACA DINÁMICA (CHAT / HORÓSCOPO)
    --------------------------------------------------- */
    .upper-card {
      position: absolute;
      bottom: 60px; /* Alineado justo arriba del zócalo RSS de 60px */
      left: 0px;
      width: 1920px;
      background: rgba(12, 10, 24, 0.98);
      border-top: 3px solid #ec4899;
      border-bottom: 2px solid rgba(236, 72, 153, 0.4);
      padding: 14px 24px;
      backdrop-filter: blur(16px);
      box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.85);
      transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      min-height: 140px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .upper-card.hidden-card {
      opacity: 0;
      transform: translateY(20px);
      pointer-events: none;
    }

    /* ESTILOS DE CHAT / OYENTES AL AIRE */
    .chat-mode-border {
      border-top-color: #ec4899;
      border-left: 8px solid #ec4899;
    }

    .chat-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 8px;
      line-height: 1.2;
    }

    .chat-badge {
      background: linear-gradient(90deg, #ec4899 0%, #8b5cf6 100%);
      padding: 4px 12px;
      border-radius: 4px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: #ffffff;
      font-weight: 900;
      font-size: 22px;
      letter-spacing: 1px;
      text-transform: uppercase;
      font-family: 'Orbitron', sans-serif;
    }

    .chat-badge-dot {
      width: 8px;
      height: 8px;
      background-color: #00ff66;
      border-radius: 50%;
      box-shadow: 0 0 8px #00ff66;
    }

    .chat-author {
      color: #f472b6;
      font-weight: 900;
      font-size: 24px;
      text-transform: uppercase;
      background: rgba(0, 242, 254, 0.12);
      border: 1px solid rgba(0, 242, 254, 0.35);
      padding: 2px 10px;
      border-radius: 4px;
    }

    .chat-location {
      color: #00f2fe;
      font-size: 24px;
      font-weight: 700;
      background: rgba(0, 242, 254, 0.12);
      border: 1px solid rgba(0, 242, 254, 0.35);
      padding: 2px 10px;
      border-radius: 4px;
    }

    .chat-body {
      color: #ffffff;
      font-size: 34px;
      font-weight: 900;
      line-height: 1.35;
      font-style: italic;
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.9);
      white-space: normal !important;
      word-wrap: break-word !important;
    }

    /* ESTILOS DE HORÓSCOPO BROADCAST */
    .horoscope-mode-border {
      border-top-color: #f59e0b;
      border-left: 8px solid #f59e0b;
      background: linear-gradient(180deg, rgba(8, 15, 30, 0.98) 0%, rgba(3, 7, 18, 0.99) 100%);
      padding: 12px 24px;
    }

    .horoscope-layout {
      display: flex;
      align-items: center;
      width: 100%;
      gap: 25px;
    }

    .horoscope-sign-badge {
      display: flex;
      align-items: center;
      gap: 16px;
      background: linear-gradient(135deg, #1e293b 0%, #0b1329 100%);
      padding: 8px 18px;
      border-radius: 8px;
      border: 2px solid #f59e0b;
      min-width: 380px;
      flex-shrink: 0;
      box-shadow: 0 4px 15px rgba(0,0,0,0.6);
    }

    .sign-icon-box {
      width: 68px;
      height: 68px;
      background: radial-gradient(circle, rgba(245, 158, 11, 0.25) 0%, rgba(15, 23, 42, 0.9) 100%);
      border: 2px solid #f59e0b;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #f59e0b;
      flex-shrink: 0;
      filter: drop-shadow(0 0 8px rgba(245, 158, 11, 0.6));
    }

    .sign-icon-box svg {
      width: 48px;
      height: 48px;
    }

    .sign-meta-text {
      display: flex;
      flex-direction: column;
    }

    .sign-name-title {
      font-family: 'Oswald', sans-serif;
      font-size: 42px;
      font-weight: 800;
      color: #ffffff;
      text-transform: uppercase;
      line-height: 1;
      letter-spacing: 1px;
    }

    .sign-date-range {
      font-size: 15px;
      font-weight: 800;
      color: #f59e0b;
      text-transform: uppercase;
      margin-top: 4px;
      letter-spacing: 1px;
    }

    .horoscope-text-wrapper {
      flex: 1;
      overflow: hidden;
      position: relative;
      display: flex;
      align-items: center;
      height: 60px;
    }

    .horoscope-prediction-text {
      font-size: 34px;
      font-weight: 800;
      color: #ffffff;
      white-space: nowrap;
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.9);
      position: absolute;
      left: 0;
      will-change: transform;
    }

    .horoscope-counter-badge {
      background: #090d16;
      border: 1px solid #f59e0b;
      color: #f59e0b;
      font-family: 'Orbitron', sans-serif;
      font-size: 16px;
      font-weight: 900;
      padding: 4px 12px;
      border-radius: 6px;
      margin-left: auto;
      flex-shrink: 0;
    }

    /* ---------------------------------------------------
       2. PISO INFERIOR: TICKER DE NOTICIAS RSS (PERMANENTE)
    --------------------------------------------------- */
    .news-row {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 1920px;
      height: 60px;
      background: rgba(8, 8, 14, 0.98);
      border-top: 2px solid #3b82f6;
      display: flex;
      align-items: center;
    }

    .news-badge {
      flex-shrink: 0;
      background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
      height: 100%;
      padding: 0 22px;
      display: flex;
      align-items: center;
      color: #ffffff;
      font-weight: 900;
      font-size: 24px;
      letter-spacing: 2px;
      white-space: nowrap;
      text-transform: uppercase;
      font-family: 'Orbitron', sans-serif;
      z-index: 30;
      box-shadow: 4px 0 12px rgba(0,0,0,0.5);
    }

    .ticker-wrapper {
      flex: 1 1 0%;
      min-width: 0;
      height: 100%;
      overflow: hidden;
      position: relative;
      display: flex;
      align-items: center;
    }

    .ticker-content {
      display: flex;
      align-items: center;
      white-space: nowrap;
      position: absolute;
      will-change: transform;
    }

    .news-item {
      display: inline-flex;
      align-items: center;
      font-size: 22px;
      font-weight: 700;
      color: #ffffff;
      padding-right: 40px;
    }

    .news-source {
      background: rgba(255, 255, 255, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.2);
      color: #38bdf8;
      font-weight: 900;
      font-size: 14px;
      padding: 3px 8px;
      border-radius: 4px;
      margin-right: 12px;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .news-separator {
      color: #2563eb;
      margin-left: 25px;
      font-size: 18px;
    }
  </style>
</head>
<body>

