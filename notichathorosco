  </div>

  <!-- FIREBASE & MASTER BROADCAST MOTOR -->
  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
    import { getFirestore, collection, query, where, orderBy, onSnapshot } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js";

    const firebaseConfig = {
      apiKey: "AIzaSyARhC07Q4CvEqB1JytYK_AkY2_HQw4ToSY",
      authDomain: "dj-tv-estacion-mix.firebaseapp.com",
      projectId: "dj-tv-estacion-mix",
      storageBucket: "dj-tv-estacion-mix.firebasestorage.app",
      messagingSenderId: "955348774578",
      appId: "1:955348774578:web:221c8f8edac25a53e023ab"
    };

    const app = initializeApp(firebaseConfig);
    const db = getFirestore(app);

    // Vectores SVG limpios para cada signo
    const ZODIAC_SVGS = {
      aries: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21V9"/><path d="M12 9a5 5 0 0 0-5-5c-2.8 0-5 2.2-5 5 0 2.5 2 4.5 4.5 4.5"/><path d="M12 9a5 5 0 0 1 5-5c2.8 0 5 2.2 5 5 0 2.5-2 4.5-4.5 4.5"/></svg>`,
      taurus: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="14" r="6"/><path d="M6 4a6 6 0 0 0 12 0"/></svg>`,
      gemini: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4a16 16 0 0 0 16 0"/><path d="M4 20a16 16 0 0 1 16 0"/><path d="M8 4v16"/><path d="M16 4v16"/></svg>`,
      cancer: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="10" r="3"/><circle cx="18" cy="14" r="3"/><path d="M9 10a7 7 0 0 0 11-4"/><path d="M15 14a7 7 0 0 0-11 4"/></svg>`,
      leo: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="7" cy="17" r="3"/><path d="M10 17c0-4 3-7 7-7a4 4 0 0 0 0-8c-2.5 0-4.5 2-4.5 4.5 0 3.5 2 5.5 2 8.5 0 2.5-2 4-4.5 4"/></svg>`,
      virgo: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4v10a3 3 0 0 0 6 0V4"/><path d="M10 4v10a3 3 0 0 0 6 0V4"/><path d="M16 4v10a3 3 0 0 0 3 3h1"/><path d="M18 13a3 3 0 1 1 0 6 3 3 0 0 1 0-6z"/></svg>`,
      libra: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h16"/><path d="M4 16h16"/><path d="M8 16a4 4 0 0 1 8 0"/><path d="M12 5v7"/><path d="M9 8h6"/></svg>`,
      scorpio: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4v10a3 3 0 0 0 6 0V4"/><path d="M10 4v10a3 3 0 0 0 6 0V4"/><path d="M16 4v11a2 2 0 0 0 2 2h3"/><path d="m19 15 3 2-3 2"/></svg>`,
      sagittarius: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 5 5 19"/><path d="M14 5h5v5"/><path d="M9 9 5 5"/><path d="M19 19l-4-4"/></svg>`,
      capricorn: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4l5 13a2 2 0 0 0 4 0l3-8"/><circle cx="18" cy="15" r="3"/><path d="M18 18c0 2-1.5 3.5-3.5 3.5S11 20 11 18"/></svg>`,
      aquarius: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 8 3-3 4 4 4-4 4 4 3-3"/><path d="m3 16 3-3 4 4 4-4 4 4 3-3"/></svg>`,
      pisces: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16"/><path d="M6 4a16 16 0 0 1 0 16"/><path d="M18 4a16 16 0 0 0 0 16"/></svg>`
    };

    const ZODIAC_CONFIG = [
      { key: 'aries',       apiKey: 'aries',       name: 'Aries',       dates: '21 MAR - 19 ABR' },
      { key: 'taurus',      apiKey: 'Taurus',      name: 'Tauro',       dates: '20 ABR - 20 MAY' },
      { key: 'gemini',      apiKey: 'Gemini',      name: 'Géminis',     dates: '21 MAY - 20 JUN' },
      { key: 'cancer',      apiKey: 'Cancer',      name: 'Cáncer',      dates: '21 JUN - 22 JUL' },
      { key: 'leo',         apiKey: 'leo',         name: 'Leo',         dates: '23 JUL - 22 AGO' },
      { key: 'virgo',       apiKey: 'Virgo',       name: 'Virgo',       dates: '23 AGO - 22 SEP' },
      { key: 'libra',       apiKey: 'Libra',       name: 'Libra',       dates: '23 SEP - 22 OCT' },
      { key: 'scorpio',     apiKey: 'Scorpio',     name: 'Escorpio',    dates: '23 OCT - 21 NOV' },
      { key: 'sagittarius', apiKey: 'Sagittarius', name: 'Sagitario',   dates: '22 NOV - 21 DIC' },
      { key: 'capricorn',   apiKey: 'Capricorn',   name: 'Capricornio', dates: '22 DIC - 19 ENE' },
      { key: 'aquarius',    apiKey: 'Aquarius',    name: 'Acuario',     dates: '20 ENE - 18 FEB' },
      { key: 'pisces',      apiKey: 'Pisces',      name: 'Piscis',      dates: '19 FEB - 20 MAR' }
    ];

    let chatMessages = [];
    let horoscopeList = [];
    let chatIndex = 0;
    let horoscopeIndex = 0;
    let masterCycleStep = 0; // 0 = Chat, 1 = Horóscopo
    let isMasterLoopRunning = false;
    let activeMarqueeFrame = null;

    const upperCard = document.getElementById('upperCard');
    const cardDynamicContent = document.getElementById('cardDynamicContent');

    // Escuchador de Mensajes Firestore
    const q = query(
      collection(db, "mensajes"),
      where("estado", "==", "aprobado"),
      orderBy("timestamp", "desc")
    );

    onSnapshot(q, (snapshot) => {
      const rawList = [];
      snapshot.forEach(doc => {
        const data = doc.data();
        data.id = doc.id;
        rawList.push(data);
      });

      chatMessages = rawList.filter(msg => {
        if (!msg.timestamp) return true;
        const msgTime = msg.timestamp.toDate ? msg.timestamp.toDate().getTime() : Date.now();
        return (Date.now() - msgTime) <= 24 * 60 * 60 * 1000;
      });

      if (!isMasterLoopRunning) {
        startMasterBroadcastLoop();
      }
    });

    // Carga Silenciosa de Horóscopos
    async function loadHoroscopeAPIs() {
      const fetched = [];
      for (const sign of ZODIAC_CONFIG) {
        try {
          const url = `https://api.jotform.com/website-widgets/templates/019f365ed74870008e184f2271ab1b90f656/execute-action?action=getHoroscopeData&period=daily&sign=${sign.apiKey}&language=es&widgetID=01a120be41b070008003137f1833c7dc8d78`;
          const res = await fetch(url);
          if (res.ok) {
            const json = await res.json();
            if (json && json.content && json.content.horoscope) {
              fetched.push({ ...sign, text: json.content.horoscope.trim() });
            }
          }
        } catch (e) {
          console.warn(`Horoscope API skip: ${sign.name}`);
        }
      }
      horoscopeList = fetched;
      if (!isMasterLoopRunning) {
        startMasterBroadcastLoop();
      }
    }

    loadHoroscopeAPIs();
    setInterval(loadHoroscopeAPIs, 2 * 60 * 60 * 1000);

    // CICLO MAESTRO DE NAVEGACIÓN TV
    function startMasterBroadcastLoop() {
      if (activeMarqueeFrame) cancelAnimationFrame(activeMarqueeFrame);
      isMasterLoopRunning = true;

      if (masterCycleStep === 0 && chatMessages.length > 0) {
        renderChatCard();
      } else if (horoscopeList.length > 0) {
        renderHoroscopeCard();
      } else if (chatMessages.length > 0) {
        renderChatCard();
      } else {
        upperCard.classList.add('hidden-card');
        isMasterLoopRunning = false;
        setTimeout(startMasterBroadcastLoop, 5000);
      }
    }

    // RENDERIZADO: CHAT DE OYENTES
    function renderChatCard() {
      if (chatIndex >= chatMessages.length) chatIndex = 0;
      const msg = chatMessages[chatIndex];

      upperCard.className = 'upper-card hidden-card chat-mode-border';

      const lugarHtml = (msg.lugar && msg.lugar.trim() !== '')
        ? `<span class="chat-location">📍 ${msg.lugar.trim()}</span>`
        : '';

      cardDynamicContent.innerHTML = `
        <div class="chat-header">
          <span class="chat-badge"><span class="chat-badge-dot"></span> OYENTE AL AIRE</span>
          <span class="chat-author">${msg.nombre || 'ANÓNIMO'}</span>
          ${lugarHtml}
        </div>
        <div class="chat-body">"${msg.msj || ''}"</div>
      `;

      setTimeout(() => {
        upperCard.classList.remove('hidden-card');
      }, 100);

      setTimeout(() => {
        upperCard.classList.add('hidden-card');
        setTimeout(() => {
          chatIndex = (chatIndex + 1) % chatMessages.length;
          masterCycleStep = 1;
          setTimeout(startMasterBroadcastLoop, 1200);
        }, 400);
      }, 22000);
    }

    // RENDERIZADO: HORÓSCOPO DIARIO (TEXTO FIJO INICIAL + DESPLAZAMIENTO PERFECTO + SIN PANTALLA VACÍA)
    function renderHoroscopeCard() {
      if (horoscopeIndex >= horoscopeList.length) horoscopeIndex = 0;
      const item = horoscopeList[horoscopeIndex];

      upperCard.className = 'upper-card hidden-card horoscope-mode-border';

      const signNum = String(horoscopeIndex + 1).padStart(2, '0');
      const totalNum = String(horoscopeList.length).padStart(2, '0');

      cardDynamicContent.innerHTML = `
        <div class="horoscope-layout">
          <div class="horoscope-sign-badge">
            <div class="sign-icon-box">${ZODIAC_SVGS[item.key] || ''}</div>
            <div class="sign-meta-text">
              <div class="sign-name-title">${item.name}</div>
              <div class="sign-date-range">${item.dates}</div>
            </div>
          </div>
          <div class="horoscope-text-wrapper" id="horoscopeWrapper">
            <div class="horoscope-prediction-text" id="horoscopeText">${item.text}</div>
          </div>
          <div class="horoscope-counter-badge">HORÓSCOPO ${signNum}/${totalNum}</div>
        </div>
      `;

      setTimeout(() => {
        upperCard.classList.remove('hidden-card');

        const wrapper = document.getElementById('horoscopeWrapper');
        const textElem = document.getElementById('horoscopeText');

        if (wrapper && textElem) {
          const wrapperWidth = wrapper.offsetWidth;
          const textWidth = textElem.offsetWidth;
          const overflowDistance = textWidth - wrapperWidth;

          // Si el texto es largo, aplica el efecto de lectura completo con pausa inicial
          if (overflowDistance > 0) {
            const speedPxPerSec = 85; // Velocidad suave TV
            const scrollDurationMs = (overflowDistance / speedPxPerSec) * 1000;
            const initialPauseMs = 3500; // Pausa inicial para comenzar a leer quieto
            const finalPauseMs = 2500;   // Pausa final al llegar al último punto

            let startTime = null;

            function animateStep(timestamp) {
              if (!startTime) startTime = timestamp;
              const elapsed = timestamp - startTime;

              if (elapsed < initialPauseMs) {
                // Fase 1: Mantiene el texto en el inicio
                textElem.style.transform = 'translateX(0px)';
              } else if (elapsed < (initialPauseMs + scrollDurationMs)) {
                // Fase 2: Desplaza suavemente hasta el final exacto del texto
                const progress = (elapsed - initialPauseMs) / scrollDurationMs;
                const currentX = progress * overflowDistance;
                textElem.style.transform = `translateX(-${currentX}px)`;
              } else {
                // Fase 3: Detiene en el final exacto
                textElem.style.transform = `translateX(-${overflowDistance}px)`;
              }

              if (elapsed < (initialPauseMs + scrollDurationMs + finalPauseMs)) {
                activeMarqueeFrame = requestAnimationFrame(animateStep);
              } else {
                // Fin del texto: Oculta la placa inmediatamente sin dejar espacio en blanco
                upperCard.classList.add('hidden-card');
                setTimeout(() => {
                  horoscopeIndex = (horoscopeIndex + 1) % horoscopeList.length;
                  masterCycleStep = 0; // Cambiar turno a Chat
                  setTimeout(startMasterBroadcastLoop, 1200);
                }, 400);
              }
            }

            activeMarqueeFrame = requestAnimationFrame(animateStep);

          } else {
            // Si el texto es corto y cabe entero, mostrarlo fijo durante 15 segundos
            textElem.style.transform = 'translateX(0px)';
            setTimeout(() => {
              upperCard.classList.add('hidden-card');
              setTimeout(() => {
                horoscopeIndex = (horoscopeIndex + 1) % horoscopeList.length;
                masterCycleStep = 0;
                setTimeout(startMasterBroadcastLoop, 1200);
              }, 400);
            }, 15000);
          }
        }
      }, 100);
    }
  </script>

  <!-- SCRIPT NOTICIAS RSS INFERIOR (FILTRADO Y CONTINUO) -->
  <script>
